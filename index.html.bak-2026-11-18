<style>
  :root {
    --navy: #1A3045; --navy-deep: #0f1f30; --charcoal: #2A3B4C;
    --gold: #D4B57F; --gold-bright: #E2C593; --gold-deep: #B89865;
    --cream: #F2F0E6; --cream-light: #F8F5EB; --taupe-light: #D9CDBA;
    --muted: #5d6873; --line: rgba(212,181,127,.32);
    --shadow: 0 12px 36px rgba(26,48,69,.12); --shadow-lg: 0 24px 60px rgba(26,48,69,.18);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', sans-serif; color: var(--charcoal); background: var(--cream); line-height: 1.7; -webkit-font-smoothing: antialiased; }
  h1, h2, h3, h4 { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; color: var(--navy); line-height: 1.15; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2.3rem, 4.8vw, 3.8rem); }
  h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); }
  h3 { font-size: 1.3rem; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
  [id] { scroll-margin-top: 90px; }

  /* draft banner */
  .draft-bar { background: var(--gold); color: var(--navy); text-align: center; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; padding: 8px 16px; }

  /* ornament */
  .ornament { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 18px 0; }
  .ornament-line { width: 60px; height: 1px; background: var(--gold); }
  .ornament-diamond { width: 8px; height: 8px; background: var(--gold); transform: rotate(45deg); }
  .ornament.left { justify-content: flex-start; }

  /* photo slot */
  .photo-slot { position: relative; overflow: hidden; background: linear-gradient(135deg, var(--navy) 0%, var(--charcoal) 55%, var(--gold-deep) 150%); display: flex; align-items: flex-end; border: 1px solid rgba(212,181,127,.3); min-height: 200px; }
  .photo-slot::before { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(45deg, rgba(242,240,230,.035) 0 2px, transparent 2px 22px); }
  .photo-slot-tag { position: relative; z-index: 3; font-size: .6rem; letter-spacing: .22em; text-transform: uppercase; font-weight: 600; color: var(--cream); background: rgba(15,31,48,.6); border: 1px solid rgba(212,181,127,.45); padding: 8px 12px; margin: 16px; max-width: 80%; line-height: 1.4; }
  .photo-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }

  /* header */
  header { position: sticky; top: 0; background: rgba(242,240,230,.96); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); z-index: 100; }
  .nav { display: flex; align-items: center; justify-content: space-between; padding: 16px 28px; max-width: 1200px; margin: 0 auto; gap: 20px; }
  .logo { display: flex; flex-direction: column; text-decoration: none; line-height: 1; }
  .logo-name { font-family: 'Playfair Display', serif; font-weight: 800; font-size: 1.45rem; letter-spacing: .06em; color: var(--navy); text-transform: uppercase; }
  .logo-sub { font-size: .6rem; color: var(--gold-deep); letter-spacing: .3em; margin-top: 6px; font-weight: 600; text-transform: uppercase; }
  nav ul { display: flex; gap: 30px; list-style: none; align-items: center; }
  nav a { color: var(--navy); text-decoration: none; font-weight: 500; font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; }
  nav a:hover { color: var(--gold-deep); }

  /* buttons */
  .cal-btn { cursor: pointer; }
  .btn { display: inline-block; padding: 14px 28px; text-decoration: none; font-weight: 600; font-size: .78rem; transition: all .3s ease; border: none; cursor: pointer; letter-spacing: .16em; text-transform: uppercase; font-family: 'Inter', sans-serif; text-align: center; }
  .btn-primary { background: var(--navy); color: var(--cream); border: 1px solid var(--navy); }
  .btn-primary:hover { background: var(--gold); color: var(--navy); border-color: var(--gold); }
  .btn-gold { background: var(--gold); color: var(--navy); border: 1px solid var(--gold); }
  .btn-gold:hover { background: var(--cream); border-color: var(--cream); }
  .btn-outline-cream { background: transparent; color: var(--cream); border: 1px solid rgba(242,240,230,.7); }
  .btn-outline-cream:hover { background: var(--cream); color: var(--navy); }

  /* hero */
  .hero { position: relative; background: var(--navy); color: var(--cream); padding: 110px 0 120px; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hero-bg .photo-slot { position: absolute; inset: 0; border: none; align-items: flex-start; justify-content: flex-end; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(100deg, rgba(15,31,48,.94) 0%, rgba(15,31,48,.78) 55%, rgba(26,48,69,.55) 100%); pointer-events: none; }
  .hero::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 5px; background: var(--gold); z-index: 2; }
  .hero .container { position: relative; z-index: 2; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr .9fr; gap: 64px; align-items: center; }
  .hero-eyebrow { color: var(--gold); font-size: .75rem; letter-spacing: .32em; text-transform: uppercase; margin-bottom: 24px; font-weight: 600; }
  .hero h1 { color: var(--cream); margin-bottom: 26px; }
  .hero h1 em { font-style: italic; color: var(--gold); font-weight: 500; display: block; }
  .hero p.lead { font-size: 1.1rem; margin-bottom: 34px; color: rgba(242,240,230,.86); max-width: 560px; line-height: 1.7; }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-note { margin-top: 26px; font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(242,240,230,.62); }
  .hero-card { background: var(--cream); color: var(--charcoal); padding: 40px; box-shadow: var(--shadow-lg); position: relative; isolation: isolate; }
  .hero-card::before { content: ''; position: absolute; inset: -1px; border: 1px solid var(--gold); transform: translate(8px, 8px); z-index: -1; }
  .card-eyebrow { color: var(--gold-deep); font-size: .7rem; letter-spacing: .28em; text-transform: uppercase; font-weight: 600; margin-bottom: 8px; display: block; }
  .hero-card h3 { margin-bottom: 8px; font-size: 1.55rem; }
  .hero-card p { color: var(--muted); margin-bottom: 18px; font-size: .94rem; }
  .tick-list { list-style: none; margin-bottom: 24px; }
  .tick-list li { padding: 10px 0 10px 24px; border-top: 1px solid var(--line); font-size: .9rem; position: relative; line-height: 1.5; }
  .tick-list li::before { content: '✦'; position: absolute; left: 0; color: var(--gold-deep); }
  .hero-card .btn { width: 100%; }

  /* proof bar */
  .proof { background: var(--navy-deep); color: var(--cream); }
  .proof-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .proof-grid div { text-align: center; padding: 24px 14px; border-right: 1px solid rgba(255,255,255,.08); font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .proof-grid div:last-child { border-right: none; }
  .proof-grid div::before { content: '◆'; color: var(--gold); font-size: .5rem; margin-right: 9px; vertical-align: middle; }

  /* sections */
  section { padding: 96px 0; }
  .section-cream { background: var(--cream); }
  .section-light { background: var(--cream-light); }
  .section-navy { background: var(--navy); color: var(--cream); }
  .section-navy h2, .section-navy h3, .section-navy h4 { color: var(--cream); }
  .section-header { text-align: center; max-width: 760px; margin: 0 auto 52px; }
  .eyebrow { color: var(--gold-deep); font-weight: 600; text-transform: uppercase; letter-spacing: .3em; font-size: .74rem; margin-bottom: 18px; display: block; }
  .section-navy .eyebrow { color: var(--gold); }
  .section-header p { color: var(--muted); font-size: 1.06rem; margin-top: 20px; line-height: 1.75; }
  .section-navy .section-header p { color: rgba(242,240,230,.76); }

  /* comparison */
  .compare { display: grid; grid-template-columns: 1fr 1.08fr 1fr; gap: 22px; align-items: stretch; }
  .cmp-card { background: var(--cream-light); border: 1px solid var(--line); padding: 36px 32px; display: flex; flex-direction: column; }
  .cmp-card.us { background: var(--navy); border-color: var(--gold); box-shadow: var(--shadow-lg); transform: translateY(-14px); }
  .cmp-card .kicker { font-size: .66rem; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; color: var(--muted); margin-bottom: 10px; }
  .cmp-card.us .kicker { color: var(--gold); }
  .cmp-card h3 { margin-bottom: 14px; }
  .cmp-card.us h3 { color: var(--cream); }
  .cmp-card p { font-size: .95rem; color: var(--muted); margin-bottom: 22px; }
  .cmp-card.us p { color: rgba(242,240,230,.8); }
  .cmp-rows { list-style: none; margin-top: auto; }
  .cmp-rows li { padding: 11px 0; border-top: 1px solid var(--line); font-size: .9rem; display: flex; justify-content: space-between; gap: 12px; }
  .cmp-card.us .cmp-rows li { border-color: rgba(242,240,230,.15); color: rgba(242,240,230,.9); }
  .cmp-rows .lbl { opacity: .75; }
  .cmp-rows .val { font-weight: 600; color: var(--navy); text-align: right; }
  .cmp-card.us .cmp-rows .val { color: var(--gold); }
  .price-bar { margin: 4px 0 24px; }
  .price-bar .track { height: 8px; background: rgba(26,48,69,.1); position: relative; }
  .cmp-card.us .price-bar .track { background: rgba(242,240,230,.15); }
  .price-bar .fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--charcoal); opacity: .55; }
  .cmp-card.us .price-bar .fill { background: var(--gold); opacity: 1; }
  .price-bar .cap { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 600; margin-top: 8px; color: var(--muted); }
  .cmp-card.us .price-bar .cap { color: var(--gold); }
  .fine { text-align: center; font-size: .82rem; color: var(--muted); margin-top: 34px; font-style: italic; }

  /* why it costs less */
  .waste-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: rgba(212,181,127,.3); border: 1px solid rgba(212,181,127,.3); }
  .waste { background: var(--navy); padding: 40px 38px; }
  .waste .w-num { font-family: 'Playfair Display', serif; font-style: italic; color: var(--gold); font-size: 1.4rem; margin-bottom: 14px; }
  .waste h3 { margin-bottom: 18px; font-size: 1.4rem; }
  .waste .usual, .waste .ours { display: grid; grid-template-columns: 74px 1fr; gap: 14px; font-size: .95rem; line-height: 1.6; padding: 12px 0; }
  .waste .usual { color: rgba(242,240,230,.66); border-top: 1px solid rgba(242,240,230,.12); }
  .waste .ours { color: var(--cream); border-top: 1px solid rgba(212,181,127,.35); }
  .waste .tag { font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; padding-top: 4px; }
  .waste .usual .tag { color: rgba(242,240,230,.5); }
  .waste .ours .tag { color: var(--gold); }
  .waste-foot { max-width: 760px; margin: 44px auto 0; text-align: center; font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--cream); line-height: 1.5; }
  .waste-foot em { color: var(--gold); }

  /* standard vs custom */
  .sc-head { text-align: center; max-width: 820px; margin: 0 auto 48px; }
  .sc-head h2 em { color: var(--gold-deep); font-style: italic; font-weight: 500; }
  .sc-head p { color: var(--muted); font-size: 1.05rem; margin-top: 18px; }
  .sc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .sc-col { padding: 40px 38px; border: 1px solid var(--line); background: var(--cream-light); }
  .sc-col.custom { background: var(--navy); border-color: var(--gold); }
  .sc-col h3 { margin-bottom: 6px; }
  .sc-col.custom h3 { color: var(--cream); }
  .sc-col .sub { font-size: .92rem; color: var(--muted); margin-bottom: 20px; }
  .sc-col.custom .sub { color: rgba(242,240,230,.72); }
  .sc-col ul { list-style: none; }
  .sc-col li { padding: 12px 0 12px 28px; border-top: 1px solid var(--line); position: relative; font-size: .95rem; }
  .sc-col.custom li { color: rgba(242,240,230,.9); border-color: rgba(242,240,230,.14); }
  .sc-col li::before { content: '◆'; position: absolute; left: 0; top: 13px; font-size: .55rem; color: var(--gold-deep); }
  .sc-col.custom li::before { color: var(--gold); }
  .sc-col li strong { color: var(--navy); font-weight: 600; }
  .sc-col.custom li strong { color: var(--cream); }

  /* quality split */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
  .split .media { aspect-ratio: 4/5; position: relative; box-shadow: var(--shadow-lg); }
  .split .media .photo-slot { position: absolute; inset: 0; min-height: 0; }
  .split .media::before { content: ''; position: absolute; inset: -18px; border: 1px solid var(--gold); z-index: -1; }
  .split h2 { margin-bottom: 18px; }
  .split .copy > p { color: var(--muted); margin-bottom: 16px; font-size: 1.01rem; }
  .spec-list { margin-top: 26px; display: flex; flex-direction: column; }
  .spec { display: grid; grid-template-columns: 150px 1fr; gap: 18px; padding: 15px 0; border-top: 1px solid var(--line); font-size: .94rem; line-height: 1.6; }
  .spec:last-child { border-bottom: 1px solid var(--line); }
  .spec .k { font-size: .66rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; color: var(--gold-deep); padding-top: 4px; }
  .spec .v strong { color: var(--navy); }

  /* doors */
  .doors { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 8px; }
  .door { text-align: center; }
  .door-art { aspect-ratio: 3/4.2; background: var(--cream-light); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; padding: 26px; margin-bottom: 16px; transition: all .3s; }
  .door:hover .door-art { border-color: var(--gold); box-shadow: var(--shadow); transform: translateY(-3px); }
  .door-art svg { width: 100%; height: 100%; }
  .door h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .door p { font-size: .86rem; color: var(--muted); line-height: 1.5; }
  .doors-note { margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .note-box { border: 1px solid var(--line); padding: 26px 28px; background: var(--cream-light); }
  .note-box h4 { font-size: 1.1rem; margin-bottom: 6px; }
  .note-box p { font-size: .93rem; color: var(--muted); }

  /* samples band */
  .band { display: grid; grid-template-columns: 1.1fr .9fr; min-height: 420px; }
  .band .photo-slot { min-height: 420px; border: none; }
  .band-copy { background: var(--navy); color: var(--cream); padding: 64px; display: flex; flex-direction: column; justify-content: center; }
  .band-copy h2 { color: var(--cream); margin-bottom: 18px; }
  .band-copy p { color: rgba(242,240,230,.78); margin-bottom: 14px; }

  /* software placeholder */
  .placeholder-box { max-width: 900px; margin: 0 auto; border: 2px dashed var(--gold-deep); background: var(--cream-light); padding: 44px; text-align: center; }
  .placeholder-box .ph-tag { display: inline-block; background: var(--gold); color: var(--navy); font-size: .62rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; padding: 5px 12px; margin-bottom: 18px; }
  .placeholder-box h3 { font-size: 1.6rem; margin-bottom: 12px; }
  .placeholder-box p { color: var(--muted); max-width: 640px; margin: 0 auto 10px; }
  .sw-points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 30px; text-align: left; }
  .sw-points div { background: var(--cream); border: 1px solid var(--line); padding: 22px; font-size: .9rem; color: var(--muted); }
  .sw-points strong { display: block; color: var(--navy); font-family: 'Playfair Display', serif; font-size: 1.05rem; margin-bottom: 6px; }

  /* process */
  .timeline { display: grid; grid-template-columns: repeat(5, 1fr); position: relative; margin-top: 56px; }
  .timeline::before { content: ''; position: absolute; top: 26px; left: 10%; right: 10%; height: 2px; background: rgba(212,181,127,.4); }
  .phase { text-align: center; padding: 0 16px; position: relative; z-index: 2; }
  .phase-num { width: 54px; height: 54px; border-radius: 50%; border: 2px solid var(--gold); color: var(--gold); display: flex; align-items: center; justify-content: center; margin: 0 auto 22px; background: var(--navy); font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.1rem; }
  .phase h4 { font-size: 1.1rem; margin-bottom: 10px; }
  .phase p { color: rgba(242,240,230,.72); font-size: .9rem; line-height: 1.6; }
  .process-foot { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(212,181,127,.3); border: 1px solid rgba(212,181,127,.3); margin-top: 60px; }
  .process-foot div { background: var(--navy); padding: 26px 28px; }
  .process-foot strong { display: block; font-family: 'Playfair Display', serif; color: var(--gold); font-size: 1.6rem; line-height: 1.1; margin-bottom: 6px; }
  .process-foot span { color: rgba(242,240,230,.72); font-size: .88rem; }

  /* rooms */
  .rooms { display: grid; grid-template-columns: 1.4fr 1fr 1fr; grid-auto-rows: 220px; gap: 18px; }
  .room { position: relative; overflow: hidden; border: 1px solid var(--line); }
  .room.main { grid-row: span 2; }
  .room .photo-slot { position: absolute; inset: 0; border: none; min-height: 0; align-items: flex-start; }
  .room-cap { position: absolute; inset: 0; z-index: 4; display: flex; flex-direction: column; justify-content: flex-end; padding: 24px; background: linear-gradient(to top, rgba(15,31,48,.88) 0%, rgba(15,31,48,.2) 60%, transparent 100%); }
  .room-cap .tag { color: var(--gold); font-size: .64rem; letter-spacing: .24em; text-transform: uppercase; font-weight: 600; margin-bottom: 6px; }
  .room-cap h3 { color: var(--cream); font-size: 1.3rem; margin-bottom: 4px; }
  .room.main .room-cap h3 { font-size: 1.9rem; }
  .room-cap p { color: rgba(242,240,230,.82); font-size: .88rem; line-height: 1.5; }
  .min-note { margin: 34px auto 0; max-width: 760px; text-align: center; padding: 24px 30px; border-top: 1px solid var(--gold); border-bottom: 1px solid var(--gold); color: var(--charcoal); font-size: 1rem; }
  .min-note strong { color: var(--navy); }

  /* founder */
  .founder { display: grid; grid-template-columns: 1fr 1fr; gap: 74px; align-items: center; }
  .founder .media { aspect-ratio: 4/5; position: relative; box-shadow: var(--shadow-lg); }
  .founder .media .photo-slot { position: absolute; inset: 0; min-height: 0; }
  .founder .media::before { content: ''; position: absolute; inset: -20px; border: 1px solid var(--gold); z-index: -1; }
  .founder h2 { margin-bottom: 22px; }
  .founder h2 em { font-style: italic; color: var(--gold); font-weight: 500; }
  .founder p { color: rgba(242,240,230,.84); font-size: 1.02rem; line-height: 1.85; margin-bottom: 18px; }
  .saw { background: rgba(242,240,230,.05); border-left: 2px solid var(--gold); padding: 22px 26px; margin: 28px 0 8px; }
  .saw .yr { font-family: 'Playfair Display', serif; color: var(--gold); font-size: 2.2rem; font-weight: 700; line-height: 1; margin-bottom: 8px; }
  .saw p { margin: 0; font-size: .96rem; }

  /* reels */
  .reels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .reel-card { text-decoration: none; background: var(--cream-light); border: 1px solid var(--line); transition: all .3s; display: flex; flex-direction: column; }
  .reel-card:hover { border-color: var(--gold); transform: translateY(-4px); box-shadow: var(--shadow); }
  .reel-thumb { position: relative; aspect-ratio: 4/3; }
  .reel-thumb .photo-slot { position: absolute; inset: 0; border: none; min-height: 0; }
  .reel-play { position: absolute; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center; }
  .reel-play span { width: 56px; height: 56px; border-radius: 50%; background: rgba(15,31,48,.55); border: 1px solid rgba(242,240,230,.7); display: flex; align-items: center; justify-content: center; }
  .reel-play svg { width: 18px; height: 18px; fill: var(--cream); margin-left: 3px; }
  .reel-body { padding: 22px 24px 26px; }
  .reel-topic { color: var(--gold-deep); font-size: .64rem; letter-spacing: .22em; text-transform: uppercase; font-weight: 600; margin-bottom: 6px; }
